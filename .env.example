# 单模型：填写对应服务的模型名、地址与密钥；页面默认显示 AI_MODEL。
AI_API_KEY=replace-me
AI_API_BASE_URL=https://spark-api-open.xf-yun.com/v1
AI_MODEL=4.0Ultra
# AI_MODEL_NAME=自定义展示名
SERVER_PORT=3001

# 多模型时可改用 AI_MODELS；不要同时保留无效的 JSON。
# AI_MODELS=[{"id":"model-a","name":"模型 A","baseUrl":"https://example.com/v1","model":"model-name","apiKey":"replace-me"}]
# 可选：意图识别固定使用这个已配置的模型 ID；留空时使用本轮选中的模型（未选择则默认模型）。
# AI_ROUTER_MODEL_ID=model-a

# 公司背调：配置受信任的 Streamable HTTP MCP 搜索服务；不配置时返回 MCP_NOT_CONFIGURED。
# MCP_SEARCH_URL=https://mcp.example.com/mcp
# MCP_SEARCH_TOKEN=replace-me
# MCP_SEARCH_TOOL=search
# MCP_SEARCH_QUERY_ARG=query
